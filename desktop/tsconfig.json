{
	"compilerOptions": {
		"target": "ES2023",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
