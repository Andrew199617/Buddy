# Copy to docker/buddy/.env (git-ignored) and fill in.

# Signs sessions and encrypts stored tokens. Reuse the key of the data you move
# into Docker so existing sign-ins and connected tools keep working.
WEBUI_SECRET_KEY=

# Address people use to open Buddy (OAuth callbacks and links use it).
BUDDY_PUBLIC_URL=http://localhost:8082

# Extra host names allowed for MCP OAuth callbacks, comma-separated.
BUDDY_ALLOWED_HOSTS=

# Tailscale (or other) host name the frontend server should answer to.
# IP addresses and localhost are always allowed.
BUDDY_TAILNET_HOST=localhost

# Host ports: the frontend (open this one) and the backend.
BUDDY_PORT=8082
BUDDY_BACKEND_PORT=8081
