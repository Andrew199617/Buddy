# Copy to docker/buddy/.env (git-ignored) and fill in.

# Signs sessions and encrypts stored tokens. Reuse the key of the data you move
# into Docker so existing sign-ins and connected tools keep working.
WEBUI_SECRET_KEY=

# Address people use to open Buddy (OAuth callbacks and links use it).
BUDDY_PUBLIC_URL=http://localhost:8082

# Extra hosts, comma-separated, such as a Tailscale name or IP. The frontend
# server answers to them and MCP OAuth callbacks may return to them. The
# frontend also answers to any IP address and localhost; OAuth callbacks also
# allow localhost and the host of the saved WebUI URL (BUDDY_PUBLIC_URL on new
# data), so list a Tailscale IP here if MCP sign-ins go through it.
BUDDY_ALLOWED_HOSTS=

# Host ports: the frontend (open this one) and the backend.
BUDDY_PORT=8082
BUDDY_BACKEND_PORT=8081
